{
  "name": "hackculture",
  "version": "0.1.0",
  "description": "Privacy-first, token-optimized coding agent with Bifrost gateway integration",
  "type": "module",
  "bin": {
    "hackculture": "./dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc",
    "start": "node dist/cli/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "RUN_INTEGRATION_TESTS=true vitest run tests/e2e/integration.test.ts",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "bifrost",
    "tavily",
    "ollama",
    "token-optimization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tavily/core": "^1.0.0",
    "commander": "^12.0.0",
    "glob": "^11.0.0",
    "ink": "^5.0.0",
    "js-yaml": "^4.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "react": "^18.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pino": "^7.0.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
